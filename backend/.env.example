# AI Powered Assistance Platform Backend Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual secrets.
# NEVER commit .env to version control.

# Database (Neon Serverless PostgreSQL or local PostgreSQL)
# Neon Pooled connection (recommended for application traffic):
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# Neon Direct connection (optional, for direct administration and migrations):
DIRECT_URL=postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

# JWT Token Signing Secret (Must be >= 32 characters in production)
# Generate using: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-secure-token-urlsafe-64-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Local Ollama Config (Sole LLM Provider)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT=120.0

# Storage Paths & Telemetry
CHROMA_PATH=./data/chroma_db
ANONYMIZED_TELEMETRY=False
CHROMA_ANONYMIZED_TELEMETRY=False
UPLOAD_DIR=./uploads

# Deployment Configuration
ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

# SMTP Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=noreply@ai-powered-assistance-platform.com
RESEND_API_KEY=

# Token Expiry Settings
EMAIL_VERIFICATION_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_MINUTES=15

# Adzuna Job Search API
ADZUNA_APP_ID=your-adzuna-app-id
ADZUNA_APP_KEY=your-adzuna-app-key

# Rate Limiting & Logging
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
