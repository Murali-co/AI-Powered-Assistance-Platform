# AI Powered Assistance Platform Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual secrets.
# NEVER commit .env to version control.

# Database (Neon Serverless PostgreSQL or local PostgreSQL)
# Neon Pooled connection (recommended for application traffic):
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require
# Neon Direct connection (optional, for direct administration and migrations):
DIRECT_URL=postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/neondb?sslmode=require

POSTGRES_DB=ai_platform_db
POSTGRES_USER=ai_platform_user
POSTGRES_PASSWORD=your-secure-postgres-password
POSTGRES_PORT=5432

# ChromaDB Vector Store
CHROMA_PORT=8000
CHROMA_PATH=./data/chroma_db
ANONYMIZED_TELEMETRY=False
CHROMA_ANONYMIZED_TELEMETRY=False

# Local Ollama LLM (Sole LLM Provider)
LLM_PROVIDER=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT=120.0

# FastAPI Backend & JWT Configuration
BACKEND_PORT=8000
# Generate a new 64-character secret key with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-secure-token-urlsafe-64-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
ENVIRONMENT=development
DEBUG=true

# Frontend Configuration
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:8000

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# Email Service Configuration (SMTP / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
EMAIL_FROM=noreply@ai-powered-assistance-platform.com
RESEND_API_KEY=

# Email Token Expiry Settings
EMAIL_VERIFICATION_EXPIRY_HOURS=24
PASSWORD_RESET_EXPIRY_MINUTES=15

# File Uploads
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=104857600

# Job Scraper & Scheduling
JOBSPY_RETRIES=3
SCRAPE_DELAY_SECONDS=5

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Logging
LOG_LEVEL=INFO
